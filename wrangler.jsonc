{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hkeventadmin",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "hkevent",
      "bucket_name": "hkevent"
    }
  ]
}
